# ---------------------------------------------------------------------------
# Universal WordPress Agent — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Where per-client YAML configs live (relative to project root or absolute)
CLIENT_CONFIG_DIR=config/clients

# Redis (queue, dead-letter, scheduler index)
REDIS_URL=redis://localhost:6379/0

# Anthropic / Claude API
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-opus-4-7

# Gmail OAuth (per-tenant; the agent reads creds from a secrets store at runtime)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Webhook security (HMAC shared secret). Per-client secrets live in YAML config.
WEBHOOK_DEFAULT_SECRET=change-me

# CRM credentials are NOT stored here. They are referenced by
# `crm_credentials_secret_id` in each client YAML and looked up from a secret
# manager (or env-var lookup keyed on the secret id) at runtime.

# Logging
LOG_LEVEL=INFO

# Misc
ENV=development
